<% layout("/layouts/boilerplate") %>
    <% 
      const buildUrl = (overrides = {}) => {
        const merged = { ...(queryParams || {}), ...overrides };
        const params = new URLSearchParams();

        Object.entries(merged).forEach(([key, value]) => {
          if (value !== undefined && value !== null && value !== "") {
            params.set(key, value);
          }
        });

        const query = params.toString();
        return query ? `/listings?${query}` : "/listings";
      };
    %>
    <style>
      #filters {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 0.5rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
      }
      .filters {
        text-align: center;
        margin-right: 1rem;
        margin-top: 1rem;
        opacity: 0.7;
        flex: 0 0 auto;
      }
      .filters:hover {
        opacity: 1;
        cursor: pointer;
      }
      .filters p {
        font-size: 0.8rem;
      }
      .filters.active {
        opacity: 1;
      }
      .filters a {
        color: inherit;
        text-decoration: none;
      }
      .tax-toogle {
        margin-left: auto;
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.25rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        white-space: nowrap;
      }
    </style>
    <div id="filters">
      <div class="filters <%= selectedCategory === 'All' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: undefined, page: 1 }) %>">
          <div><i class="fa-solid fa-border-all"></i></div>
          <p>All</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Trending' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Trending', page: 1 }) %>">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Rooms', page: 1 }) %>">
          <div><i class="fa-solid fa-bed"></i></div>
          <p>Rooms</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Iconic Cities' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Iconic Cities', page: 1 }) %>">
          <div><i class="fa-solid fa-mountain-city"></i></div>
          <p>Iconic Cities</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Mountains', page: 1 }) %>">
          <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountains</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Castles' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Castles', page: 1 }) %>">
          <div><i class="fa-solid fa-fort-awesome"></i></div>
          <p>Castles</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Amazing Pools' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Amazing Pools', page: 1 }) %>">
          <div><i class="fa-solid fa-person-swimming"></i></div>
          <p>Amazing Pools</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Camping' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Camping', page: 1 }) %>">
          <div><i class="fa-solid fa-campground"></i></div>
          <p>Camping</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Farms' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Farms', page: 1 }) %>">
          <div><i class="fa-solid fa-cow"></i></div>
          <p>Farms</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Arctic' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Arctic', page: 1 }) %>">
          <div><i class="fa-solid fa-snowflake"></i></div>
          <p>Arctic</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Domes' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Domes', page: 1 }) %>">
          <div><i class="fa-solid fa-igloo"></i></div>
          <p>Domes</p>
        </a>
      </div>
      <div class="filters <%= selectedCategory === 'Boats' ? 'active' : '' %>">
        <a href="<%= buildUrl({ category: 'Boats', page: 1 }) %>">
          <div><i class="fa-solid fa-ship"></i></div>
          <p>Boats</p>
        </a>
      </div>

      <div class="tax-toogle">
        <div class="form-check-reverse form-switch">
          <input type="checkbox" role="switch" class="form-check-input" id="flexSwitchCheckDefault">
          <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>
      </div>
    </div>
    <div class="container mt-5">
      <div class="row">
        <% if (!allListings || allListings.length === 0) { %>
          <div class="col-12 text-center py-5">
            <h5 class="mb-2">No listings found</h5>
            <p class="text-muted">Try changing your search or filters.</p>
          </div>
        <% } %>
        <% for(let listing of allListings){ %>
          <div class="col-md-4 mb-4">
            <div class="card listing-card h-100">
              <img src="<%= listing.image.url %>" class="card-img-top home-img">
              <div class="card-body">
                <h5 class="card-title">
                  <%= listing.title %>
                </h5>
                <p class="card-text text-muted">
                  <%= listing.location %>, <%= listing.country %>
                </p>
                <p class="fw-bold tax-price" data-base-price="<%= listing.price != null ? listing.price : '' %>">
                  ₹ <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
                </p>
                <a href="/listings/<%= listing._id %>" class="btn btn-dark stretched-link">
                  View Details
                </a>
              </div>
            </div>
          </div>
          <% } %>
      </div>

      <% if (pagination && pagination.totalPages > 1) { %>
        <nav aria-label="Listings pagination" class="mt-4">
          <ul class="pagination justify-content-center">
            <li class="page-item <%= pagination.hasPrevPage ? '' : 'disabled' %>">
              <a class="page-link" href="<%= pagination.hasPrevPage ? buildUrl({ page: pagination.currentPage - 1 }) : '#' %>">Previous</a>
            </li>

            <li class="page-item disabled">
              <span class="page-link">Page <%= pagination.currentPage %> of <%= pagination.totalPages %></span>
            </li>

            <li class="page-item <%= pagination.hasNextPage ? '' : 'disabled' %>">
              <a class="page-link" href="<%= pagination.hasNextPage ? buildUrl({ page: pagination.currentPage + 1 }) : '#' %>">Next</a>
            </li>
          </ul>
          <p class="text-center text-muted small">Total listings: <%= pagination.totalListings %></p>
        </nav>
      <% } %>
    </div>

    <script>
      const taxSwitch = document.getElementById("flexSwitchCheckDefault");
      const priceElements = document.querySelectorAll(".tax-price");

      const renderPrice = (includeTax) => {
        priceElements.forEach((el) => {
          const basePrice = Number(el.dataset.basePrice);
          if (!Number.isFinite(basePrice)) {
            el.textContent = "₹ N/A";
            return;
          }

          if (includeTax) {
            const totalPrice = Math.round(basePrice * 1.18);
            el.textContent = `₹ ${totalPrice.toLocaleString("en-IN")} (incl. tax)`;
          } else {
            el.textContent = `₹ ${basePrice.toLocaleString("en-IN")} / night`;
          }
        });
      };

      if (taxSwitch) {
        taxSwitch.addEventListener("change", function() {
          renderPrice(this.checked);
        });
      }
    </script>

